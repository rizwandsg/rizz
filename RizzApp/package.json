  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "node scripts/build-web.cjs",
    "vercel-build": "npm run build:web",
    "lint": "eslint . --quiet",
    "typecheck": "tsc --noEmit",
