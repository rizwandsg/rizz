    "test:watch": "vitest",
    "simulate": "node scripts/simulate.cjs",
    "check:secrets": "node scripts/check-secrets.cjs",
    "bundle:check": "node scripts/check-bundle.cjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run check:secrets && npm run bundle:check",
    "check:release": "node scripts/check-release.cjs",
    "audit:release": "npm audit --omit=dev --audit-level=high",
    "eas-build-post-install": "node scripts/check-build.cjs",
    "production:check": "node scripts/production.cjs check",
    "build:production:android": "node scripts/production.cjs android",
    "build:production:ios": "node scripts/production.cjs ios",
    "configure:production:ios": "node scripts/configure-ios-signing.cjs"
  },
