# Copy to .env.local. Use separate Firebase and Supabase staging projects.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_NAME=Rizz
EXPO_PUBLIC_FIREBASE_API_KEY=replace_with_public_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-staging-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-staging-project
EXPO_PUBLIC_FIREBASE_APP_ID=replace_with_web_sdk_app_id
EXPO_PUBLIC_PRODUCTION_FIREBASE_PROJECT_ID=your-production-project
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_replace_with_your_public_key
EXPO_PUBLIC_BACKEND_CONTRACT_VERSION=5
# Required for preview/production builds; used to reject accidental live-data previews.
EXPO_PUBLIC_PRODUCTION_SUPABASE_URL=https://your-production-project.supabase.co
# FIREBASE_SERVICE_ACCOUNT_JSON belongs only in Supabase Edge Function secrets.
