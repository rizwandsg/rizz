# Copy to .env.local. Use a separate Supabase project and Clerk test instance.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_NAME=Rizz
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_dev_key_here
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_replace_with_your_public_key
EXPO_PUBLIC_BACKEND_CONTRACT_VERSION=2
# Required for preview/production builds; used to reject accidental live-data previews.
EXPO_PUBLIC_PRODUCTION_SUPABASE_URL=https://your-production-project.supabase.co
# CLERK_SECRET_KEY belongs only in Supabase Edge Function secrets, never in this file.
