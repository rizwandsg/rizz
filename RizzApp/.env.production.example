# Copy to .env.production.local. This file contains public client settings only.
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_APP_NAME=Rizz
EXPO_PUBLIC_FIREBASE_API_KEY=replace_with_public_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=replace-with-project
EXPO_PUBLIC_FIREBASE_APP_ID=replace_with_web_sdk_app_id
EXPO_PUBLIC_PRODUCTION_FIREBASE_PROJECT_ID=replace-with-project
EXPO_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_replace_with_production_public_key
EXPO_PUBLIC_PRODUCTION_SUPABASE_URL=https://your-production-project.supabase.co
EXPO_PUBLIC_BACKEND_CONTRACT_VERSION=5
# Deploy and verify the migration before setting up a store build.
# FIREBASE_SERVICE_ACCOUNT_JSON is a Supabase function secret, never a client setting.
